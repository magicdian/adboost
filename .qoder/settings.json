{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .qoder/hooks/phronia-hook.py --event session-start --platform qoder",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .qoder/hooks/phronia-hook.py --event session-start --platform qoder",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .qoder/hooks/phronia-hook.py --event session-start --platform qoder",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .qoder/hooks/phronia-hook.py --event pre-shell --platform qoder",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .qoder/hooks/phronia-hook.py --event user-prompt --platform qoder",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
